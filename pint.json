{
    "preset": "laravel",
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor"
    ],
    "rules": {
        "ordered_imports": true,
        "no_unused_imports": true,
        "single_trait_insert_per_statement": true,
        "concat_space": {
            "spacing": "one"
        },
        "single_quote": true,
        "array_syntax": {
            "syntax": "short"
        },
        "trailing_comma_in_multiline": true,
        "no_superfluous_phpdoc_tags": true,
        "phpdoc_align": {
            "align": "left"
        },
        "phpdoc_separation": true,
        "phpdoc_trim": true,
        "phpdoc_scalar": true,
        "blank_line_before_statement": {
            "statements": [
                "return",
                "try",
                "if",
                "foreach"
            ]
        }
    }
}
